# 1) librerie
library(readr)
library(dplyr)
library(ggplot2)
library(patchwork)
setwd("C:/Users/tomma/OneDrive/Desktop/Bioinformatic/Project")
# 2) leggi i metadata
meta <- read_tsv("Data/metadata.txt", col_names = TRUE) %>%
rename(
sample_status  = status,         # la colonna 3
disease_status = `status:ch1`,   # la colonna con “:ch1”
age            = `age:ch1`,
gender         = `gender:ch1`,
ethnicity      = `ethnicity:ch1`
)
mutate(
gender    = as.factor(gender),
ethnicity = as.factor(ethnicity),
status    = as.factor(status),
age       = as.numeric(age)
)
